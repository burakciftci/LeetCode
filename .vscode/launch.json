{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "MedianOfTwoSortedArrays",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/MedianOfTwoSortedArrays/bin/Debug/net9.0/MedianOfTwoSortedArrays.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bhttps?://\\S+\\b"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": "SlidingTechnique",
